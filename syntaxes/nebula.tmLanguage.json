{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nebula",
  "scopeName": "source.nebula",
  "fileTypes": [
    "neb",
    "nbl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#methods"
    },
    {
      "include": "#classes_and_structs"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nebula",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nebula",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nebula",
          "match": "\\b(if|else|for|while|switch|case|default|return|foreach|in|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.nebula",
          "match": "\\b(class|namespace|native|new|const|is|import|alias|get|set|struct|operator|interface|abstract)\\b"
        },
        {
          "name": "storage.modifier.nebula",
          "match": "\\b(public|private|static|override)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.nebula",
          "match": "\\b(void|bool|char|byte|sbyte|short|int|long|float|double|int8|int16|int32|int64|uint8|uint16|uint32|uint64|ushort|uint|ulong|string)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nebula",
          "match": "\\b0[xX][0-9a-fA-F]([0-9a-fA-F]|_(?=[0-9a-fA-F]))*[bBsSlLuU]*\\b"
        },
        {
          "name": "constant.numeric.binary.nebula",
          "match": "\\b0[bB][01]([01]|_(?=[01]))*[bBsSlLuU]*\\b"
        },
        {
          "name": "constant.numeric.float.nebula",
          "match": "\\b([0-9]([0-9]|_(?=[0-9]))*(\\.[0-9]([0-9]|_(?=[0-9]))*)?|\\.[0-9]([0-9]|_(?=[0-9]))*)(([eE][+-]?[0-9]([0-9]|_(?=[0-9]))*)?)?[fF]\\b"
        },
        {
          "name": "constant.numeric.double.nebula",
          "match": "\\b([0-9]([0-9]|_(?=[0-9]))*(\\.[0-9]([0-9]|_(?=[0-9]))*)?|\\.[0-9]([0-9]|_(?=[0-9]))*)(([eE][+-]?[0-9]([0-9]|_(?=[0-9]))*)?)?[dD]?\\b"
        },
        {
          "name": "constant.numeric.integer.nebula",
          "match": "\\b[0-9]([0-9]|_(?=[0-9]))*[bBsSlLuU]*\\b"
        },
        {
          "name": "constant.language.boolean.nebula",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.nebula",
          "match": "\\b(null)\\b"
        },
        {
          "name": "constant.character.nebula",
          "match": "'((?:\\\\.)|[^\\\\'])'"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.compound-assignment.nebula",
          "match": "(\\*\\*=|<<=|>>=|&=|\\^=|\\|=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.logical.nebula",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.nebula",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.bitwise.nebula",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.nebula",
          "match": "(\\+\\+|--|\\*\\*|\\*|/|%|\\+|\\-)"
        },
        {
          "name": "keyword.operator.assignment.nebula",
          "match": "="
        },
        {
          "name": "keyword.operator.ternary.nebula",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.curly.nebula",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.parenthesis.nebula",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.square.nebula",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.terminator.statement.nebula",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.nebula",
          "match": ","
        },
        {
          "name": "punctuation.separator.dot.nebula",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.nebula",
          "match": ":"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.interpolated.nebula",
          "begin": "(\\$)\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nebula"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nebula"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.nebula",
              "match": "\\\\."
            },
            {
              "name": "constant.character.escape.nebula",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "meta.interpolation.nebula",
              "begin": "(?<!\\{)\\{(?!\\{)",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.begin.nebula"
                }
              },
              "end": "(?<!\\})\\}(?!\\})",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.end.nebula"
                }
              },
              "contentName": "source.nebula",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "match": "[^\\\\\"{}]+",
              "name": "string.quoted.interpolated.content.nebula"
            }
          ]
        },
        {
          "name": "string.quoted.double.nebula",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nebula",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "methods": {
      "patterns": [
        {
          "name": "entity.name.function.nebula",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
        }
      ]
    },
    "classes_and_structs": {
      "patterns": [
        {
          "name": "entity.name.type.class.nebula",
          "match": "(?<=\\bclass\\s+)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\{)"
        },
        {
          "name": "entity.name.type.struct.nebula",
          "match": "(?<=\\bstruct\\s+)([a-zA-Z_][a-zA-Z0-9_]*)"
        },
        {
          "name": "entity.name.type.nebula",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.nebula",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}